# Copia este archivo a .env y completa tus claves.
# Este proyecto usa su PROPIO .env (ya no depende del .env del curso).

OPENAI_API_KEY=tu_openai_api_key
TAVILY_API_KEY=tu_tavily_api_key

# LangSmith para trazabilidad
LANGSMITH_API_KEY=tu_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agente-noticias-win

# Destinatarios (separados por coma para enviar a varios directivos) y modelo
NEWS_RECIPIENT=directivo1@win.pe,directivo2@win.pe
NEWS_MODEL=gpt-5-mini

# Historial anti-repeticion en SQLite local (opcional; ruta relativa al proyecto o absoluta).
# NEWS_DB_PATH=data/agente_noticias.db

# Cuantas semanas hacia atras se revisan para no repetir noticias (opcional)
DEDUP_WEEKS=6

# Imagenes de las tarjetas del newsletter (ilustracion IA via OpenRouter).
OPENROUTER_API_KEY=tu_openrouter_api_key
# Modelo de imagen en OpenRouter (opcional).
NEWS_IMAGE_MODEL=openai/gpt-image-2
# Calidad: low | medium | high | auto (opcional; medium por defecto).
# NEWS_IMAGE_QUALITY=medium
# false = no generar con IA; usa la imagen og:image de la noticia o un placeholder de marca.
NEWS_IMAGES_ENABLED=true
